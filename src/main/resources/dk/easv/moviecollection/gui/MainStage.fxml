<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="600.0" minWidth="900.0" prefHeight="640.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.moviecollection.gui.MainStageController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="65.0" prefWidth="839.0" spacing="20.0" BorderPane.alignment="CENTER">
            <children>
            <Region prefHeight="25.0" prefWidth="417.0" />
                <Label prefHeight="18.0" prefWidth="33.0" text="Filter:" />
                <TextField fx:id="filter" promptText="Search movie..." />
            <ComboBox fx:id="ratingComboBox" prefWidth="150.0" promptText="IMDB rating: any" />
                <Button mnemonicParsing="false" text="🔍" />
            <Button mnemonicParsing="false" text="Clear" />
            </children>
            <padding>
                <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
            </padding>
        </HBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.28, 0.55" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
            <items>
                <!-- Left: Categories -->
                <VBox prefHeight="623.0" prefWidth="195.0" spacing="10.0">
                    <children>
                        <Label styleClass="header-label" text="CATEGORIES" />
                        <TableView fx:id="tableCategories" prefHeight="551.0" prefWidth="220.0" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="columnCategory" prefWidth="100.0" text="Name" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                        <HBox alignment="CENTER" spacing="10.0">
                            <children>
                                <Button onAction="#onAddCategoryClick" text="New" />
                                <Button onAction="#onDeleteCategory" text="Delete" />
                            </children>
                            <padding>
                                <Insets bottom="10.0" />
                            </padding>
                        </HBox>
                    </children>
                    <padding>
                        <Insets left="10.0" right="5.0" />
                    </padding>
                </VBox>

                <!-- Middle: Movies in category -->
                <VBox spacing="10.0">
                    <children>
                        <Label styleClass="header-label" text="MOVIES IN CATEGORY" />
                        <ListView fx:id="moviesInCategoryList" onMouseClicked="#playFromCategoryList" prefHeight="550.0" prefWidth="178.0" VBox.vgrow="ALWAYS" />
                        <HBox alignment="CENTER" spacing="10.0">
                            <children>
                                <Button onAction="#deleteMovieFromCategory" text="Delete" />
                            </children>
                            <padding>
                                <Insets bottom="10.0" />
                            </padding>
                        </HBox>
                    </children>
                    <padding>
                        <Insets left="5.0" right="5.0" />
                    </padding>
                </VBox>

                <!-- Right: All movies -->
                <VBox prefHeight="623.0" prefWidth="467.0" spacing="10.0">
                    <children>
                        <Label styleClass="header-label" text="MOVIES" />
                        <TableView fx:id="tableMovies" onMouseClicked="#playFromMainList" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="columnName" prefWidth="154.86798346042633" text="Name" />
                                <TableColumn fx:id="columnPersonalRating" prefWidth="95.99995422363281" text="Personal rating" />
                                <TableColumn fx:id="columnIMDBRating" prefWidth="76.9810791015625" text="IMDB rating" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Button onAction="#addMovieToCategory" prefHeight="25.0" prefWidth="150.0" text="⬅️ Add to Category" />
            
                            <Button onAction="#onNewMovie" prefHeight="25.0" prefWidth="59.0" text="New">
                                <HBox.margin>
                                    <Insets />
                                </HBox.margin>
                            </Button>
                                <Button onAction="#onEditMovie" prefHeight="25.0" prefWidth="56.0" text="Edit" />
                                <Button onAction="#deleteMovie" prefHeight="25.0" prefWidth="75.0" text="Delete" />
                                <Button onAction="#openMovie" prefHeight="25.0" prefWidth="56.0" text="Play" />
                        <Button mnemonicParsing="false" onAction="#onCloseButtonClick" prefHeight="25.0" prefWidth="64.0" text="Close" />
                            </children>
                            <padding>
                                <Insets bottom="10.0" />
                            </padding>
                        </HBox>
                    </children>
                    <padding>
                        <Insets left="5.0" right="10.0" />
                    </padding>
                </VBox>
            </items>

            <BorderPane.margin>
                <Insets bottom="10.0" left="30.0" right="30.0" top="0.0" />
            </BorderPane.margin>
        </SplitPane>
    </center>
   <bottom>
      <Label fx:id="errorLabel" alignment="BOTTOM_LEFT" prefHeight="27.0" prefWidth="429.0" textFill="#ee4b10" BorderPane.alignment="CENTER_LEFT">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
   </bottom>
</BorderPane>
