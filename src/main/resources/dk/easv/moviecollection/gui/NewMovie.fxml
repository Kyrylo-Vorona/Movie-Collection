<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="285.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.moviecollection.gui.NewMovieController">
   <children>
      <VBox alignment="TOP_CENTER" layoutX="22.0" layoutY="64.0" prefHeight="147.0" prefWidth="174.0">
         <children>
            <Label prefHeight="35.0" prefWidth="171.0" text="Name:">
               <font>
                  <Font size="24.0" />
               </font>
            </Label>
            <Label prefHeight="35.0" prefWidth="173.0" text="IMDB rating:">
               <font>
                  <Font size="24.0" />
               </font>
            </Label>
            <Label prefHeight="36.0" prefWidth="176.0" text="Personal rating:">
               <font>
                  <Font size="24.0" />
               </font>
            </Label>
            <Label prefHeight="35.0" prefWidth="178.0" text="Filelink:">
               <font>
                  <Font size="24.0" />
               </font>
            </Label>
         </children>
      </VBox>
      <TextField fx:id="nameTextField" layoutX="197.0" layoutY="70.0" prefHeight="25.0" prefWidth="175.0" />
      <TextField fx:id="imdbRatingTextField" layoutX="197.0" layoutY="109.0" prefHeight="25.0" prefWidth="176.0" />
      <TextField fx:id="personalRatingTextField" layoutX="197.0" layoutY="144.0" prefHeight="25.0" prefWidth="177.0" />
      <TextField fx:id="filelinkTextField" layoutX="197.0" layoutY="177.0" prefHeight="25.0" prefWidth="178.0" />
      <Label layoutX="218.0" layoutY="14.0" text="Add/Edit movie">
         <font>
            <Font size="24.0" />
         </font>
      </Label>
      <Label fx:id="errorLabel" layoutX="22.0" layoutY="244.0" prefHeight="27.0" prefWidth="358.0">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Button layoutX="404.0" layoutY="231.0" mnemonicParsing="false" onAction="#onSave" prefHeight="25.0" prefWidth="60.0" text="Save">
         <font>
            <Font size="14.0" />
         </font>
      </Button>
      <Button layoutX="492.0" layoutY="231.0" mnemonicParsing="false" onAction="#onCancelButtonClick" prefHeight="25.0" prefWidth="61.0" text="Cancel">
         <font>
            <Font size="14.0" />
         </font>
      </Button>
      <Button layoutX="396.0" layoutY="177.0" mnemonicParsing="false" onAction="#chooseMovieButtonClick" text="Choose" />
   </children>
</AnchorPane>
